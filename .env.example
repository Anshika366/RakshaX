# Supabase Credentials for backend sync & user authentication
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Twilio Credentials for Automated SMS & Voice Calls
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_sender_phone_number_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# SendGrid Credentials for Automated Email Dossiers
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=your_verified_sendgrid_sender_email_here

# Google Maps Platform API Key for Geocoding and Location Lookups
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
